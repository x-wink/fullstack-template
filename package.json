{
  "name": "fullstack-monorepo",
  "version": "1.0.0",
  "author": {
    "name": "xwink",
    "email": "1041367524@qq.com"
  },
  "scripts": {
    "dev": "pnpm ssr",
    "ssr": "pnpm -F @apps/ssr dev",
    "client": "pnpm -F @apps/client dev",
    "admin": "pnpm -F @apps/admin dev",
    "server": "pnpm -F @apps/server dev",
    "build": "pnpm -F @apps/* build",
    "sftp": "pnpm -F @apps/* sftp",
    "release": "pnpm -F @apps/* release",
    "release:server": "pnpm -F @apps/server release",
    "release:admin": "pnpm -F @apps/admin release",
    "release:client": "pnpm -F @apps/client release",
    "rsa": "pnpm -F @pkgs/rsa gen",
    "lint": "oxlint --fix-suggestions --ignore-path .gitignore",
    "fmt": "oxfmt",
    "prepare": "husky install"
  },
  "dependencies": {
    "@xwink/utils": "^1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@types/node": "^18.19.130",
    "@xwink/sftp": "^1.0.4",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "ts-node": "^10.9.2",
    "typescript": "5.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "pnpm lint"
    ],
    "*.{ts,tsx,vue,html,less,md,json}": [
      "pnpm fmt"
    ]
  }
}
